# Copia este archivo a .env (NO lo subas a git) o, en producción, configura estas variables en Render > Environment.
PORT=5000
NODE_ENV=production

# Base de datos (Atlas). Usa un usuario con permisos solo sobre esta base.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/sistema-sureste

# Firma de sesiones: 48+ caracteres aleatorios. Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Páginas web autorizadas a usar la API desde el navegador (además de apprgo.agentia.software). Separadas por coma.
CORS_ORIGINS=

# Render pone 1 proxy delante. Si agregas Cloudflare delante de Render, cambia a 2.
TRUST_PROXY_HOPS=1

# IA (solo en el servidor; nunca con prefijo VITE_)
GEMINI_API_KEY=
ASSISTANT_DAILY_REQUEST_LIMIT=

# Notificaciones push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# WhatsApp (API oficial)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
